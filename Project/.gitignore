# =========================
# Dependencies
# =========================
node_modules/
**/node_modules/

# =========================
# Environment variables
# Never push API keys/passwords
# =========================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# =========================
# Build output
# =========================
dist/
build/
coverage/
.vite/
**/dist/
**/build/
**/.vite/
**/coverage/

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Runtime files
# =========================
pids/
*.pid
*.seed
*.pid.lock

# =========================
# Server uploads
# =========================
uploads/
server/uploads/
*.csv
*.xlsx
*.xls

# Keep upload folder in Git if needed
!uploads/.gitkeep
!server/uploads/.gitkeep

# =========================
# Database files
# =========================
*.sqlite
*.sqlite3
*.db
*.mdb

# MongoDB local data
data/
mongodb-data/

# =========================
# Redis
# =========================
dump.rdb
appendonly.aof

# =========================
# OS-generated files
# =========================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# =========================
# Editor files
# =========================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~

# =========================
# Temporary files
# =========================
tmp/
temp/
.cache/
*.tmp
*.temp

# =========================
# Vercel / Netlify
# =========================
.vercel/
.netlify/

# =========================
# Local package manager files
# =========================
.pnpm-store/
.yarn/
.yarnrc.yml

# =========================
# Sensitive Google files
# =========================
service-account.json
google-service-account.json
credentials.json
client_secret*.json

# =========================
# Sensitive SSL files
# =========================
*.pem
*.key
*.crt
*.pfx